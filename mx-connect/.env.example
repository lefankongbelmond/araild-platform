APP_NAME=MX-CONNECT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.mx-connect.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Central connection (network DB: mutuals registry, public accounts, payment ledger, directory, social)
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=c1central
DB_USERNAME=mconnect
DB_PASSWORD=

# Tenant DB naming: stancl/tenancy creates one DB per mutual with this prefix
TENANT_DB_PREFIX=mxconnect_mut_
# Central domain that subdomains hang off (mutXX.mx-connect.com)
CENTRAL_DOMAIN=www.mx-connect.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Broadcasting / real-time (Phase 5 member feed — Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host clients connect to over WSS (behind Nginx on 443):
REVERB_HOST=www.mx-connect.com
REVERB_PORT=443
REVERB_SCHEME=https
# Local bind of the Reverb process (Nginx proxies /app and /apps to it):
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Set true only if running more than one Reverb process (needs Redis):
REVERB_SCALING_ENABLED=false

# Backups (spatie/laravel-backup) — encrypted, off-server
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mx-connect.com

# SMS gateway (abstract — configured per deployment, not hard-coded)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=MXCONNECT

# Platform limits (see config/mxconnect.php) — configurable, not hard-coded per country
MXCONNECT_MAX_MUTUALS=0
