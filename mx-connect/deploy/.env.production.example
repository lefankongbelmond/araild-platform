# =====================================================================
# MX-CONNECT — .env de PRODUCTION (www.mx-connect.com)
# Copier vers /var/www/mx-connect/.env puis remplir les valeurs vides.
# Ne JAMAIS committer ce fichier une fois rempli (secrets).
# =====================================================================

APP_NAME=MX-CONNECT
APP_ENV=production
APP_KEY=                          # généré par: php artisan key:generate
APP_DEBUG=false
APP_URL=https://www.mx-connect.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Douala

# --- Base CENTRALE (registre des mutuelles, comptes publics, grand livre paiements,
#     annuaire, offres, facturation SaaS, fil social) ---
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=c1central
DB_USERNAME=mconnect
DB_PASSWORD=                      # mot de passe MySQL fort

# --- Bases TENANT : une base par mutuelle, créée automatiquement (stancl/tenancy)
#     avec ce préfixe. Ex: mxconnect_mut_<slug> ---
TENANT_DB_PREFIX=mxconnect_mut_

# Domaine central : ni mx-connect.com ni www.mx-connect.com ne sont des tenants ;
# chaque mutuelle vit sur un sous-domaine <slug>.mx-connect.com
CENTRAL_DOMAIN=www.mx-connect.com

# --- Redis (cache, files d'attente, sessions). Si Redis indisponible, basculer
#     les trois lignes sur "database" (les tables existent déjà). ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Temps réel (fil social, Phase 5 — Laravel Reverb) ---
BROADCAST_CONNECTION=reverb
# Généré par: php artisan reverb:install  (ou saisir des valeurs aléatoires)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Hôte public auquel les navigateurs se connectent en WSS (via Nginx, port 443) :
REVERB_HOST=www.mx-connect.com
REVERB_PORT=443
REVERB_SCHEME=https
# Bind local du process Reverb (Nginx relaie /app et /apps vers lui) :
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# true seulement si plusieurs process Reverb (nécessite Redis) :
REVERB_SCALING_ENABLED=false

# --- Sauvegardes chiffrées hors-serveur (mxconnect:backup + spatie/laravel-backup) ---
BACKUP_ARCHIVE_PASSWORD=          # phrase secrète de chiffrement des archives
BACKUP_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# --- E-mail (rappels de cotisation, notifications) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mx-connect.com
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (passerelle abstraite, configurée par déploiement) ---
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=MXCONNECT

# --- Journalisation structurée (JSON, corrélée par request_id) ---
LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=info

# --- Limites plateforme (voir config/mxconnect.php) — 0 = illimité ---
MXCONNECT_MAX_MUTUALS=0
# Seuil (ms) de journalisation des requêtes lentes :
MXCONNECT_SLOW_QUERY_MS=500
# Mettre true en pré-prod/CI pour faire échouer tout lazy-loading (audit N+1) :
MXCONNECT_STRICT_LAZY=false
